# Frontend Environment Variables (Vite)
# When deploying frontend (e.g. on Vercel), set this to your backend service URL:
VITE_API_URL=http://127.0.0.1:8000

# Backend Environment Variables (FastAPI)
# Optional: MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URL=mongodb://localhost:27017

# Optional: CORS allowed origins (comma-separated, or * for all)
ALLOWED_ORIGINS=*
